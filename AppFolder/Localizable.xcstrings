    "无法打开所选浏览器。请确认已安装，或使用系统默认方式打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开所选浏览器。请确认已安装，或使用系统默认方式打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open the selected browser. Check that it is installed, or open with the system default."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟所選瀏覽器。請確認已安裝，或使用系統預設方式開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したブラウザを開けません。インストールされているか確認するか、システムの標準の方法で開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 브라우저를 열 수 없습니다. 설치되어 있는지 확인하거나 시스템 기본 방식으로 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir el navegador seleccionado. Comprueba que esté instalado o usa la opción predeterminada del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le navigateur choisi. Vérifiez qu’il est installé ou utilisez l’option par défaut du système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Browser lässt sich nicht öffnen. Prüfen Sie, ob er installiert ist, oder verwenden Sie die Systemvorgabe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o navegador selecionado. Confira se está instalado ou use a opção padrão do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть выбранный браузер. Убедитесь, что он установлен, или откройте сайт стандартным способом."
          }
        }
      }
    },
