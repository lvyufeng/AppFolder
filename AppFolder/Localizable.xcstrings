    "可搜索当地名称、英文名称或两位地区代码。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by localized name, English name, or two-letter region code."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可搜尋當地名稱、英文名稱或兩位地區代碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の言語の名前、英語名、または2文字の地域コードで検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지화된 이름, 영문 이름 또는 두 글자 지역 코드로 검색하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por el nombre traducido, el nombre en inglés o el código de región de dos letras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez par nom localisé, nom anglais ou code de région à deux lettres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach lokalisiertem Namen, englischem Namen oder zweistelligem Regionscode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque pelo nome localizado, nome em inglês ou código de região de duas letras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите по названию на текущем языке, английскому названию или двухбуквенному коду региона."
          }
        }
      }
