    "如何使用自己保存的分组？": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I use my saved groups?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如何使用自己儲存的分組？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したグループを使うには？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 그룹은 어떻게 사용하나요?"
          }
