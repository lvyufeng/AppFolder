          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新讀取，或在「我的分組」中檢查此聯絡人。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
