    "仅选择图标搜索来源，不会更改系统动作或 Apple 账户的国家/地区。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only chooses where to search for icons. It does not change system actions or your Apple Account country or region."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅選擇圖示搜尋來源，不會更改系統動作或 Apple 帳號的國家或地區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンの検索先のみを選びます。システムアクションやApple Accountの国または地域は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 검색 출처만 선택합니다. 시스템 동작이나 Apple 계정의 국가 또는 지역은 변경되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo selecciona dónde buscar iconos. No cambia las acciones del sistema ni el país o región de tu Cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce choix concerne uniquement la recherche d’icônes. Il ne modifie pas les actions système ni le pays ou la région de votre compte Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wählt nur die Quelle für die Symbolsuche. Systemaktionen und das Land oder die Region deines Apple Accounts bleiben unverändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso só escolhe onde buscar ícones. Não altera ações do sistema nem o país ou região da sua Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот выбор меняет только источник поиска значков. Системные действия и страна или регион Аккаунта Apple не изменяются."
          }
        }
      }
    },
    "先搜索美国；没有结果时再搜索中国大陆。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search the United States first, then China mainland if there are no results."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先搜尋美國；沒有結果時再搜尋中國大陸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず米国を検索し、結果がなければ中国本土を検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 미국에서 검색하고, 결과가 없으면 중국 본토에서 검색합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca primero en Estados Unidos y después en China continental si no hay resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche d’abord aux États-Unis, puis en Chine continentale si aucun résultat n’est trouvé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht zuerst in den USA und bei fehlenden Ergebnissen in China Festland."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca primeiro nos Estados Unidos e depois na China continental se não houver resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала поиск выполняется в США, а при отсутствии результатов — в материковом Китае."
          }
        }
      }
    },
