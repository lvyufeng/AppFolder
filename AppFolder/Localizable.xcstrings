            "value": "Esta copia supera los 32 MB y no se puede procesar. Elige una copia de AppFolder más pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde dépasse 32 Mo et ne peut pas être traitée. Sélectionnez une sauvegarde AppFolder plus petite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
