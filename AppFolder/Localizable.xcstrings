    "名称首尾空格会忽略，最多 64 个字符。最多保存 64 个预设。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称首尾空格会忽略，最多 64 个字符。最多保存 64 个预设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱首尾空格會忽略，最多 64 個字元。最多儲存 64 個預設。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leading and trailing spaces are ignored. Names can contain up to 64 characters. You can save up to 64 presets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の前後の空白は無視されます。名前は64文字まで、プリセットは64件まで保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 앞뒤의 공백은 무시됩니다. 이름은 최대 64자이며, 프리셋은 최대 64개 저장할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignoran los espacios al principio y al final. Los nombres admiten hasta 64 caracteres. Puedes guardar hasta 64 preajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces au début et à la fin sont ignorés. Les noms sont limités à 64 caractères. Vous pouvez enregistrer jusqu’à 64 préréglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerzeichen am Anfang und Ende werden ignoriert. Namen dürfen bis zu 64 Zeichen enthalten. Du kannst bis zu 64 Vorlagen speichern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaços no início e no fim são ignorados. Os nomes podem ter até 64 caracteres. Você pode salvar até 64 predefinições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробелы в начале и конце игнорируются. Название может содержать до 64 символов. Можно сохранить до 64 наборов."
          }
        }
      }
    },
