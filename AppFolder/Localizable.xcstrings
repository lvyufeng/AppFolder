      }
    },
    "未找到可用的网站图标，可以继续使用默认或自定义图标。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到可用的网站图标，可以继续使用默认或自定义图标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable website icon was found. You can keep using the default or a custom icon."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可用的網站圖示，可以繼續使用預設或自訂圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用できるサイトアイコンが見つかりませんでした。デフォルトまたはカスタムのアイコンを引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 있는 웹사이트 아이콘을 찾지 못했습니다. 기본 또는 사용자 지정 아이콘을 계속 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un icono de sitio válido. Puedes seguir usando el icono predeterminado o uno personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune icône de site utilisable n’a été trouvée. Vous pouvez continuer à utiliser l’icône par défaut ou une icône personnalisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein verwendbares Website-Symbol gefunden. Du kannst weiterhin das Standardsymbol oder ein eigenes Symbol verwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado um ícone de site utilizável. Você pode continuar usando o ícone padrão ou um personalizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящий значок сайта не найден. Можно продолжить использовать стандартный или собственный значок."
          }
        }
      }
    },
