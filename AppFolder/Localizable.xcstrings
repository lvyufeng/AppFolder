          "stringUnit": {
            "state": "translated",
            "value": "Derzeit wird die übergeordnete Darstellung verwendet. Änderungen an der inneren Darstellung unten erstellen eigene Einstellungen für diesen Ordner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
