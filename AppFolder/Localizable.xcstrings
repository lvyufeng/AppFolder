    "仅恢复最近移除的预设；同名预设已存在时不会覆盖。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅恢复最近移除的预设；同名预设已存在时不会覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅復原最近移除的預設；同名預設已存在時不會覆寫。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores only the most recently removed preset. An existing preset with the same name will not be overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前に削除したプリセットだけを復元します。同名のプリセットが既にある場合は上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근에 삭제한 프리셋만 복원합니다. 같은 이름의 프리셋이 이미 있으면 덮어쓰지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo restaura el último preajuste eliminado. No sobrescribe un preajuste existente con el mismo nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure uniquement le dernier préréglage supprimé. Un préréglage existant du même nom ne sera pas écrasé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt nur die zuletzt entfernte Vorlage wieder her. Eine vorhandene Vorlage mit demselben Namen wird nicht überschrieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura apenas a última predefinição removida. Uma predefinição existente com o mesmo nome não será sobrescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает только последний удалённый набор. Существующий набор с тем же названием не будет перезаписан."
          }
        }
      }
    },
