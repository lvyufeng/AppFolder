          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un nom d’action"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionsnamen erfassen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar nome de ação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать имя действия"
          }
        }
      }
    },
    "记录名称不会安装 App 或创建系统动作。使用时仍需在小组件中配置同名动作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording a name doesn’t install an app or create a system action. You still need to configure the same action name in the widget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄名稱不會安裝 App 或建立系統動作。使用時仍需在小工具中設定同名動作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の記録ではAppのインストールやシステムの動作の作成は行いません。使うにはウィジェットで同名の動作を設定する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 기록해도 앱이 설치되거나 시스템 동작이 생성되지 않습니다. 사용하려면 위젯에서 같은 이름의 동작을 구성해야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar un nombre no instala una app ni crea una acción del sistema. Aún debes configurar una acción con el mismo nombre en el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer un nom n’installe pas d’app et ne crée pas d’action système. Vous devez toujours configurer une action du même nom dans le widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erfassen eines Namens installiert keine App und erstellt keine Systemaktion. Im Widget muss weiterhin eine gleichnamige Aktion konfiguriert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar um nome não instala um app nem cria uma ação do sistema. Ainda é necessário configurar uma ação com o mesmo nome no widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись имени не устанавливает приложение и не создаёт системное действие. В виджете всё равно нужно настроить действие с таким же именем."
          }
        }
      }
    },
    "资料库已满，请先移除不需要的记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library is full. Remove unneeded records first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫已滿，請先移除不需要的記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリがいっぱいです。不要な記録を先に削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리가 가득 찼습니다. 먼저 필요 없는 기록을 제거하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca está llena. Quita primero los registros que no necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque est pleine. Retirez d’abord les fiches inutiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek ist voll. Entferne zuerst nicht benötigte Einträge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca está cheia. Remova primeiro os registros desnecessários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека заполнена. Сначала удалите ненужные записи."
          }
        }
      }
    },
    "资料没有加入整理草稿，请检查名称、标签和资料库容量后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record wasn’t added to the draft. Check its name, tags, and library capacity, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料沒有加入整理草稿，請檢查名稱、標籤與資料庫容量後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理の下書きに追加できませんでした。名前、タグ、ライブラリの容量を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료를 정리 초안에 추가하지 못했습니다. 이름, 태그, 라이브러리 용량을 확인한 후 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añadió el registro al borrador. Comprueba el nombre, las etiquetas y la capacidad de la biblioteca e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche n’a pas été ajoutée au brouillon. Vérifiez son nom, ses étiquettes et la capacité de la bibliothèque, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wurde nicht zum Entwurf hinzugefügt. Prüfe Namen, Tags und Bibliothekskapazität und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro não foi adicionado ao rascunho. Confira o nome, as etiquetas e a capacidade da biblioteca e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не добавлена в черновик. Проверьте имя, теги и вместимость библиотеки, затем повторите попытку."
          }
        }
      }
    },
    "还没有动作记录。可先配置小组件动作，或手动记录完整动作名称。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No action records yet. Configure widget actions or manually record the full action name."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有動作記錄。可先設定小工具動作，或手動記錄完整動作名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作の記録はまだありません。ウィジェットの動作を設定するか、完全な動作名を手動で記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 동작 기록이 없습니다. 위젯 동작을 구성하거나 전체 동작 이름을 직접 기록하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay registros de acciones. Configura acciones del widget o registra manualmente su nombre completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action enregistrée. Configurez des actions du widget ou saisissez leur nom complet manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Aktionseinträge. Konfiguriere Widget-Aktionen oder erfasse den vollständigen Aktionsnamen manuell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há registros de ações. Configure ações do widget ou registre manualmente o nome completo da ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей действий пока нет. Настройте действия виджета или вручную запишите полное имя действия."
          }
        }
      }
    },
    "这个名称已有资料记录，请编辑现有记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A record already exists for this name. Edit the existing record."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個名稱已有資料記錄，請編輯現有記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前の記録はすでにあります。既存の記録を編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름의 자료 기록이 이미 있습니다. 기존 기록을 편집하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un registro con este nombre. Edita el registro existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fiche existe déjà pour ce nom. Modifiez la fiche existante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Namen gibt es bereits einen Eintrag. Bearbeite den vorhandenen Eintrag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um registro com este nome. Edite o registro existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись с таким именем уже существует. Измените существующую запись."
          }
        }
      }
    },
    "这里包含小组件记录、分组引用和本地保存的名称。图标设置不会创建系统动作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This includes widget records, group references, and locally saved names. Icon settings don’t create system actions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡包含小工具記錄、分組引用與本機儲存的名稱。圖示設定不會建立系統動作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの記録、グループの参照、ローカルに保存した名前が含まれます。アイコン設定でシステムの動作は作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 위젯 기록, 그룹 참조, 로컬에 저장된 이름이 포함됩니다. 아이콘 설정은 시스템 동작을 생성하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se incluyen registros de widgets, referencias de grupos y nombres guardados localmente. Los ajustes de iconos no crean acciones del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste contient des fiches de widgets, des références de groupes et des noms enregistrés localement. Les réglages d’icônes ne créent pas d’actions système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier stehen Widget-Einträge, Gruppenverweise und lokal gespeicherte Namen. Symboleinstellungen erstellen keine Systemaktionen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista inclui registros de widgets, referências de grupos e nomes salvos localmente. As configurações de ícones não criam ações do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь показаны записи виджетов, ссылки из групп и локально сохранённые имена. Настройки значков не создают системных действий."
          }
        }
      }
    },
    "这里只整理名称与标签，不表示 App 已安装或系统动作已配置。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only organizes names and tags. It doesn’t indicate that an app is installed or a system action is configured."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡只整理名稱與標籤，不表示 App 已安裝或系統動作已設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは名前とタグを整理するだけです。Appがインストール済み、またはシステムの動作が設定済みであることを示すものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 이름과 태그만 정리합니다. 앱이 설치되었거나 시스템 동작이 구성되었다는 의미는 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se organizan nombres y etiquetas. No indica que una app esté instalada ni que una acción del sistema esté configurada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les noms et les étiquettes sont organisés ici. Cela n’indique pas qu’une app est installée ou qu’une action système est configurée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden nur Namen und Tags geordnet. Das bedeutet nicht, dass eine App installiert oder eine Systemaktion konfiguriert ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui são organizados apenas nomes e etiquetas. Isso não indica que um app esteja instalado ou que uma ação do sistema esteja configurada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь упорядочиваются только имена и теги. Это не означает, что приложение установлено или системное действие настроено."
          }
        }
      }
    },
    "选择当前结果": {
