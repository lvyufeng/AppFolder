    "桌面效果可能随系统外观调整，与这里的预览略有不同。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面效果可能随系统外观调整，与这里的预览略有不同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home Screen result may adapt to your system appearance and look slightly different from this preview."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主畫面效果可能隨系統外觀調整，與這裡的預覽略有不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の表示はシステムの外観に合わせて調整されるため、このプレビューと少し異なる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면의 모습은 시스템 모양에 따라 조정되어 이 미리보기와 약간 다를 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado en la pantalla de inicio puede adaptarse a la apariencia del sistema y ser ligeramente distinto de esta vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rendu sur l’écran d’accueil peut s’adapter à l’apparence du système et différer légèrement de cet aperçu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Darstellung auf dem Home-Bildschirm kann sich an das Erscheinungsbild des Systems anpassen und leicht von dieser Vorschau abweichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado na Tela de Início pode se adaptar à aparência do sistema e ficar um pouco diferente desta prévia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид на экране «Домой» может подстраиваться под оформление системы и немного отличаться от этого предпросмотра."
          }
        }
      }
    },
