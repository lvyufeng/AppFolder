    "恢复后由 AppFolder 按名字自动找，可能又会认错。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder will match by name again, which may get it wrong again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復後由 AppFolder 依名字自動比對，可能又會認錯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前による自動マッチングに戻ります。また間違える可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름으로 자동 매칭합니다. 다시 잘못 고를 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder volverá a buscar por nombre, y puede volver a equivocarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder recherchera à nouveau par nom, et peut se tromper encore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder sucht wieder nach Namen und kann sich erneut irren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AppFolder volta a buscar pelo nome, e pode errar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder снова будет искать по имени и может опять ошибиться."
          }
        }
      }
    },
