    "配置面板里的每一项都立即生效，不用重新添加小组件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every setting in that panel takes effect at once; you never have to add the widget again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板裡的每一項都會立即生效，不用重新加入小工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの設定はどれもすぐ反映されます。ウィジェットを追加し直す必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널의 설정은 모두 즉시 적용됩니다. 위젯을 다시 추가할 필요가 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ajuste de ese panel se aplica al momento; nunca tendrás que volver a añadir el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réglage de ce panneau s'applique aussitôt ; vous n'aurez jamais à rajouter le widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einstellung dort wirkt sofort; das Widget muss nie neu hinzugefügt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ajuste desse painel vale na hora; você nunca precisa adicionar o widget de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая настройка в этой панели применяется сразу; добавлять виджет заново не нужно."
          }
        }
      }
    },
    "长按刚放上去的小组件": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the widget you just added"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按剛放上去的小工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したウィジェットを長押し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 추가한 위젯을 길게 누르기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el widget que acabas de añadir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez le widget que vous venez d'ajouter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gerade hinzugefügte Widget gedrückt halten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure o widget que você acabou de adicionar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте только что добавленный виджет"
          }
        }
      }
    },
    "长按桌面空白处": {
      "extractionState": "manual",
      "localizations": {
