    "文字选项用于图标名称和文件夹内嵌名称，不改变图标或导航箭头。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字选项用于图标名称和文件夹内嵌名称，不改变图标或导航箭头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text options apply to icon labels and names inside folder icons. They do not change icons or navigation arrows."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字選項用於圖示名稱和資料夾內嵌名稱，不會改變圖示或導覽箭頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字の設定はアイコンの名前とフォルダアイコン内の名前に適用され、アイコンやナビゲーションの矢印は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 옵션은 아이콘 이름과 폴더 아이콘 안의 이름에 적용되며, 아이콘이나 탐색 화살표는 변경하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de texto se aplican a las etiquetas de los iconos y a los nombres dentro de los iconos de carpeta. No cambian los iconos ni las flechas de navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de texte s’appliquent aux libellés des icônes et aux noms affichés dans les icônes de dossier. Elles ne modifient ni les icônes ni les flèches de navigation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textoptionen gelten für Symbolnamen und Namen innerhalb von Ordnersymbolen. Symbole und Navigationspfeile bleiben unverändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de texto se aplicam aos nomes dos ícones e aos nomes dentro dos ícones de pasta. Elas não alteram os ícones nem as setas de navegação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры текста применяются к подписям значков и названиям внутри значков папок. Они не меняют значки и стрелки навигации."
          }
        }
      }
    },
