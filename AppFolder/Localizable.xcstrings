          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de etiquetas foi excedido. Nenhum registro foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превышено ограничение тегов. Ни одна запись не изменена."
          }
        }
      }
    },
