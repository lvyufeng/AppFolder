            "value": "整理内容を保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 내용이 저장되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios guardados."
          }
        },
        "fr": {
