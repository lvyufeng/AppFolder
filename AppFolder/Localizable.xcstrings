          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그 제한을 초과했습니다. 어떤 기록도 변경하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se superó el límite de etiquetas. No se modificó ningún registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite d’étiquettes est dépassée. Aucune fiche n’a été modifiée."
          }
        },
        "de": {
          "stringUnit": {
