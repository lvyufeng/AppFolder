            "value": "アプリ内でURLを開けません。もう一度試すか、別の開き方を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내에서 URL을 열 수 없습니다. 다시 시도하거나 다른 열기 방식을 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir esta URL dentro de la app. Inténtalo de nuevo o elige otro método."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir cette URL dans l’app. Réessayez ou choisissez une autre méthode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese URL lässt sich nicht in der App öffnen. Versuche es erneut oder wähle eine andere Öffnungsmethode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esta URL no app. Tente novamente ou escolha outra forma de abertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть адрес внутри приложения. Повторите попытку или выберите другой способ открытия."
          }
        }
      }
    },
