    "编辑位置或草稿已改变。请关闭并重新打开外观预设，再应用到当前层。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑位置或草稿已改变。请关闭并重新打开外观预设，再应用到当前层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯位置或草稿已改變。請關閉並重新開啟外觀預設，再套用到目前層級。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editing location or draft has changed. Close and reopen appearance presets before applying one to the current level."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中の場所または下書きが変更されました。外観プリセットを一度閉じて開き直してから、現在の階層に適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 위치 또는 초안이 변경되었습니다. 모양 프리셋을 닫았다가 다시 연 후 현재 계층에 적용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación de edición o el borrador ha cambiado. Cierra y vuelve a abrir los preajustes de apariencia antes de aplicar uno al nivel actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement modifié ou le brouillon a changé. Fermez et rouvrez les préréglages d’apparence avant d’en appliquer un au niveau actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bearbeitete Ebene oder der Entwurf hat sich geändert. Schließe die Darstellungsvorlagen und öffne sie erneut, bevor du eine auf die aktuelle Ebene anwendest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O local de edição ou o rascunho mudou. Feche e reabra as predefinições de aparência antes de aplicar uma ao nível atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место редактирования или черновик изменились. Закройте и снова откройте наборы оформления, прежде чем применять набор к текущему уровню."
          }
        }
      }
    },
    "当前外观": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
