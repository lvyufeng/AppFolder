    "为当前外观命名并保存，就能在其他分组或文件夹中复用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前外观命名并保存，就能在其他分组或文件夹中复用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為目前外觀命名並儲存，即可在其他分組或檔案夾中重複使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name and save the current appearance to reuse it in other groups or folders."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の外観に名前を付けて保存すると、ほかのグループやフォルダでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 모양에 이름을 붙여 저장하면 다른 그룹이나 폴더에서도 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un nombre a la apariencia actual y guárdala para reutilizarla en otros grupos o carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez et enregistrez l’apparence actuelle pour la réutiliser dans d’autres groupes ou dossiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne und speichere die aktuelle Darstellung, um sie in anderen Gruppen oder Ordnern wiederzuverwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome à aparência atual e salve-a para reutilizá-la em outros grupos ou pastas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите и сохраните текущее оформление, чтобы использовать его в других группах или папках."
