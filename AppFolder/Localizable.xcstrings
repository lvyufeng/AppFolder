    "拨号前由系统确认。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system asks for confirmation before dialing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撥號前由系統確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発信前にシステムが確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 걸기 전에 시스템에서 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema pide confirmación antes de llamar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système demande confirmation avant d’appeler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System fragt vor dem Wählen nach einer Bestätigung."
          }
