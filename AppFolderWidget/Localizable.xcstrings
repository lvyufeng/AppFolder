      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne häufig genutzte Apps, Aktionen, Kontakte und Websites gemeinsam an und öffne sie durch Tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange your favorite apps, actions, contacts, and websites together, then tap to open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza tus apps, acciones, contactos y sitios favoritos juntos y toca para abrirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez vos apps, actions, contacts et sites favoris, puis touchez-les pour les ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うApp、アクション、連絡先、ウェブサイトをまとめて配置し、タップして開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 앱, 동작, 연락처, 웹사이트를 한곳에 배치하고 탭하여 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize seus apps, ações, contatos e sites favoritos juntos e toque para abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите любимые приложения, действия, контакты и сайты вместе и открывайте их касанием."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將常用 App、動作、聯絡人和網站排在一起，點一下即可開啟。"
          }
        }
      }
    },
    "把常用 App、动作和网站排在一起，点按打开。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne Apps, Aktionen und Websites zusammen an. Tippe zum Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange your apps, actions, and websites together. Tap to open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza tus apps, acciones y sitios web. Toca para abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez vos apps, actions et sites web. Touchez pour ouvrir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うアプリ、アクション、ウェブサイトをまとめて配置。タップして開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 앱, 동작, 웹사이트를 모아 배치하고 탭하여 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize apps, ações e sites juntos. Toque para abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещайте приложения, действия и сайты вместе. Нажмите, чтобы открыть."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把常用 App、動作和網站排在一起，點一下即可開啟。"
          }
