    "选择要直开的 App，并设置这个小组件的外观。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the apps to launch in one tap, and how this widget looks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要直接開啟的 App，並設定這個小工具的外觀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで開くAppを選び、このウィジェットの見た目を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 열 앱을 고르고 이 위젯의 모양을 설정합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las apps que se abren con un toque y el aspecto de este widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les apps à ouvrir en un appui et l'apparence de ce widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Apps zum Ein-Tipp-Öffnen und das Aussehen dieses Widgets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os apps para abrir com um toque e a aparência deste widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложения для открытия одним касанием и внешний вид этого виджета."
          }
        }
      }
    },
