    "每个格子一个 App，点一下直接打开，不经过 AppFolder。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One app per cell, opened in one tap, without going through AppFolder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個格子一個 App，點一下直接開啟，不經過 AppFolder。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1マスに1つのApp。タップするとAppFolderを経由せず直接開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 칸에 앱 하나. 탭하면 AppFolder를 거치지 않고 바로 열립니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app por celda; un toque la abre sin pasar por AppFolder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app par case ; un appui l'ouvre sans passer par AppFolder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App pro Kachel; ein Tippen öffnet sie ohne Umweg über AppFolder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app por célula; um toque abre sem passar pelo AppFolder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно приложение на ячейку; касание открывает его, минуя AppFolder."
          }
        }
      }
    },
