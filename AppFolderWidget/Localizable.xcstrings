    "通过 AppFolder 按所选方式打开网站": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AppFolder 按所选方式打开网站"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the website through AppFolder using the selected method"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 AppFolder 依所選方式開啟網站"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolderを経由して選択した方法でサイトを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppFolder를 통해 선택한 방식으로 웹사이트 열기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el sitio a través de AppFolder con el método seleccionado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le site via AppFolder avec la méthode choisie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Website über AppFolder mit der gewählten Methode öffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o site pelo AppFolder com a forma selecionada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть сайт через AppFolder выбранным способом"
          }
        }
      }
    },
    "从已保存分组选择项目。网站按所选方式打开，联系人通过 AppFolder 处理；系统动作需在此配置。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从已保存分组选择项目。网站按所选方式打开，联系人通过 AppFolder 处理；系统动作需在此配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an item from a saved group. Websites use their selected opening method; contacts are handled through AppFolder. Configure system actions here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從已儲存的分組選擇項目。網站依所選方式開啟，聯絡人透過 AppFolder 處理；系統動作須在此設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みグループから項目を選択します。サイトは選択した方法で開き、連絡先はAppFolderを経由します。システムアクションはここで設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 그룹에서 항목을 선택하세요. 웹사이트는 선택한 방식으로 열리고 연락처는 AppFolder를 통해 처리됩니다. 시스템 동작은 여기에서 설정하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un elemento de un grupo guardado. Los sitios usan su método de apertura y los contactos se gestionan a través de AppFolder. Configura aquí las acciones del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un élément d’un groupe enregistré. Les sites utilisent la méthode choisie et les contacts passent par AppFolder. Configurez les actions système ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Element aus einer gespeicherten Gruppe. Websites verwenden die gewählte Öffnungsmethode; Kontakte werden über AppFolder verarbeitet. Systemaktionen werden hier eingerichtet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um item de um grupo salvo. Os sites usam a forma de abertura selecionada e os contatos são tratados pelo AppFolder. Configure as ações do sistema aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите элемент из сохранённой группы. Сайты открываются выбранным способом, а контакты обрабатываются через AppFolder. Системные действия настраиваются здесь."
          }
        }
      }
    }
  },
  "version": "1.0"
}
