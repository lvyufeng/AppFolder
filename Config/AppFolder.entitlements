<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not a permission and not a capability that grants data access: both
	     processes only need to agree on one container path. It carries two
	     things now — the app icon artwork the widget downloads, and the counter
	     the app uses to ask the widget to drop an expansion. Without it the
	     widget still works; it just cannot see the app's request. See
	     `WidgetState.resolveStorage()`. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lvyufeng.appfolder</string>
	</array>
</dict>
</plist>
