<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app, widget and website share extension use this private container
	     for saved layouts, their artwork, widget state and the website inbox.
	     The share extension writes inbox records only; the app applies them to
	     a group after the user reviews and saves that group's draft. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lvyufeng.appfolder</string>
	</array>
</dict>
</plist>
