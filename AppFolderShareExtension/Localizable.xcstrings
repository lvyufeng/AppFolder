    "保存到待添加列表，再打开 AppFolder 选择分组。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Pending websites, then open AppFolder to choose a group."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存到待加入清單，再開啟 AppFolder 選擇分組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加待ちリストに保存し、AppFolderを開いてグループを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 대기 목록에 저장한 다음 AppFolder를 열어 그룹을 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en Sitios pendientes y abre AppFolder para elegir un grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez dans Sites en attente, puis ouvrez AppFolder pour choisir un groupe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Ausstehende Websites sichern und dann AppFolder öffnen, um eine Gruppe auszuwählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve em Sites pendentes e abra o AppFolder para escolher um grupo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните в «Сайты для добавления», затем откройте AppFolder и выберите группу."
          }
        }
      }
    },
    "留空使用网站域名。名称最多 80 个字符。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to use the website’s domain. Names can contain up to 80 characters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空時使用網站網域。名稱最多 80 個字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合はドメイン名を使用します。名前は80文字以内です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 웹사이트 도메인을 사용합니다. 이름은 최대 80자입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para usar el dominio del sitio. El nombre admite hasta 80 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser le domaine du site. Le nom est limité à 80 caractères."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die Domain zu verwenden. Namen dürfen höchstens 80 Zeichen enthalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o domínio do site. O nome pode ter até 80 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать домен сайта. Максимальная длина названия — 80 символов."
          }
        }
      }
    },
    "请缩短名称，并移除换行或不支持的字符。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorten the name and remove line breaks or unsupported characters."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請縮短名稱，並移除換行或不支援的字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を短くし、改行や使用できない文字を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 줄이고 줄바꿈이나 지원하지 않는 문자를 삭제하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorta el nombre y elimina los saltos de línea o caracteres no admitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcissez le nom et retirez les sauts de ligne ou les caractères non pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte den Namen kürzen und Zeilenumbrüche oder nicht unterstützte Zeichen entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encurte o nome e remova quebras de linha ou caracteres não compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сократите название и удалите переносы строк или неподдерживаемые символы."
          }
        }
      }
    },
    "已保存到待添加列表": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Pending websites"
          }
        },
        "zh-Hant": {
          "stringUnit": {
