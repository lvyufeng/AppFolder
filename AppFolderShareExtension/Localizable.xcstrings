    "网址尚未保存。请检查设备可用空间，然后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL has not been saved. Check available storage on your device, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網址尚未儲存。請檢查裝置可用空間，然後重試。"
          }
        },
        "ja": {
          "stringUnit": {
