            "value": "追加待ちリストに保存しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 대기 목록에 저장됨"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en Sitios pendientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans Sites en attente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Ausstehende Websites gesichert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo em Sites pendentes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено в «Сайты для добавления»"
          }
        }
      }
    },
    "完成后请自行打开 AppFolder，进入「我的分组」→「待添加网页」，选择分组添加。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After finishing, open AppFolder, go to My Groups → Pending websites, and choose a group to add the website."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成後請自行開啟 AppFolder，進入「我的分組」→「待加入網頁」，選擇分組加入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了後、AppFolderで「マイグループ」→「追加待ちのサイト」を開き、追加先のグループを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 후 AppFolder에서 ‘내 그룹’ → ‘추가 대기 웹사이트’를 열고 추가할 그룹을 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar, abre AppFolder, ve a Mis grupos → Sitios pendientes y elige un grupo para añadir el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois terminé, ouvrez AppFolder, allez dans Mes groupes → Sites en attente et choisissez un groupe pour ajouter le site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Abschluss AppFolder öffnen, zu „Meine Gruppen“ → „Ausstehende Websites“ gehen und eine Gruppe zum Hinzufügen auswählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao terminar, abra o AppFolder, vá a Meus grupos → Sites pendentes e escolha um grupo para adicionar o site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После завершения откройте AppFolder, перейдите в «Мои группы» → «Сайты для добавления» и выберите группу."
          }
        }
      }
    },
